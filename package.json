{
  "name": "project-lantern",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "tools"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "node scripts/gdignore.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p server --noEmit && tsc -p tools --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "migrate": "npm run migrate -w server",
    "render-ring": "npm run render-ring -w tools --",
    "ascii-chunk": "npm run ascii-chunk -w tools --",
    "golden:update": "npm run golden:update -w tools"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
